# Maven build output
backend/target/

# Local SQLite runtime data (browsing history lives here - never commit any of
# it, including WAL/journal sidecars)
backend/data/

# Node dependencies
**/node_modules/
frontend/node_modules/
extension/node_modules/

# Frontend build output and caches
frontend/dist/
frontend/.vite/

# Extension build output
extension/dist/

# TypeScript incremental build state
**/*.tsbuildinfo
frontend/*.tsbuildinfo
extension/*.tsbuildinfo

# IDE and editor files
.vscode/
.idea/
*.iml
*.swp
*.swo
.DS_Store
Thumbs.db

# Environment and secret files
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json

# Local logs
*.log
# Local Puppeteer browser profile
.puppeteer-chrome-profile/

.puppeteer-test-profile/
